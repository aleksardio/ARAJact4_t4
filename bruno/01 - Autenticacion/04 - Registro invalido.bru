meta {
  name: 04 - Registro inválido
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {"nombre":" ","email":"correo-invalido","password":"corta"}
}

tests {
  test("Registro inválido devuelve 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().estado).to.equal(400);
    expect(res.getBody().campos).to.have.property("email");
    expect(res.getBody().campos).to.have.property("nombre");
    expect(res.getBody().campos).to.have.property("password");
  });
}
