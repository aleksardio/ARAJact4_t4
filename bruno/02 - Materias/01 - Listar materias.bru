meta {
  name: 01 - Listar materias
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/materias
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Listado autenticado devuelve una página", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().contenido).to.be.an("array");
    expect(res.getBody().pagina).to.equal(0);
  });
}
